; VIC-I survey raster program 1: a border-colour band (emu198x/emu198x#362).
;
; The display is cut to four text rows, so that the band's lines, 110 to
; 180, are border all the way across. The band is border colour 2 on
; border colour 6.

SYNC_HALF   = 10
TARGET_LINE = 110

        !source "raster-band.a"
        +header
        lda #4 << 1             ; four text rows
        sta $9003
frame   jsr sync
        +band $900f, $1a, $1e, $1b
        jmp frame

        !source "raster-sync.a"
