; A character set in RAM for the VIC-I survey's raster programs
; (emu198x/emu198x#362): character 0 is %00011011 on every line, which is
; the four multicolour pairs 00 01 10 11 in order, and in hi-res three
; paper dots, two ink, one paper and two ink. Rows 0 to 8 are multicolour
; with ink 2; the rest are hi-res with ink 2. Every cell holds character 0.

CHARSET = $1c00

!macro glyph_screen {
        ldx #7
        lda #%00011011
-       sta CHARSET,x
        dex
        bpl -
        lda #$ff                ; screen at $1e00, characters at $1c00
        sta $9005
        ldx #0
-       lda #0
        sta SCREEN,x
        sta SCREEN + $100,x
        lda #2                  ; hi-res, ink 2
        sta COLOUR,x
        sta COLOUR + $100,x
        inx
        bne -
        ldx #9 * 22 - 1
        lda #$08 | 2            ; multicolour, ink 2
-       sta COLOUR,x
        dex
        cpx #$ff
        bne -
}
