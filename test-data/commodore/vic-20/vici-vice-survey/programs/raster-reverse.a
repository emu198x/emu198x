; VIC-I survey raster program 3: a reverse-video band
; (emu198x/emu198x#362).
;
; The band writes $900f bit 3 clear (reverse on) and then set again, with
; paper 1 and border 3 unchanged, over lines 110 to 180: rows 4 to 8 of
; the display are multicolour and rows 9 to 13 hi-res (raster-glyph.a).
; Auxiliary colour 4.

SYNC_HALF   = 10
TARGET_LINE = 110

        !source "raster-band.a"
        !source "raster-glyph.a"
        +header
        +glyph_screen
        lda #$40                ; auxiliary 4, volume 0
        sta $900e
frame   jsr sync
        +band $900f, $13, $1b, $1b
        jmp frame

        !source "raster-sync.a"
