; The band kernel shared by the VIC-I survey's raster programs
; (emu198x/emu198x#362).
;
; Called at a fixed cycle of line TARGET_LINE (see raster-sync.a). Each of
; LINE_CYCLES lines writes .on to .reg and, 20 cycles later, .off, in a
; loop of LINE_CYCLES + 1 cycles - one more than a line - so both writes
; move one cycle (four pixels) right per line and between them the band
; visits every cycle of the line once. The band's edges show where the
; VIC-I puts a write made in a given cycle. Afterwards .reg is left
; holding .after.

; Cycles a line: 71 for the PAL 6561, which is the default, or 65 for the
; NTSC 6560, which a program selects by defining it first.
!ifndef LINE_CYCLES {
LINE_CYCLES = 71
}

!macro band .reg, .on, .off, .after {
        ldx #LINE_CYCLES
        lda #.off
        ldy #.on
.line   sty .reg                ; 4   the band starts
        !for i, 1, 8 { nop }    ; 16
        sta .reg                ; 4   and ends 20 cycles later
        !for i, 1, (LINE_CYCLES - 31) / 2 { nop }
        bit $00                 ; 40 + 3 on PAL, 34 + 3 on NTSC
        dex                     ; 2
        bne .line               ; 3   = LINE_CYCLES + 1 cycles a line
        lda #.after
        sta .reg
}

; The BASIC line `10 SYS4109` and the start of the program, which turns
; off every VIA interrupt and leaves the CPU's own masked: from here on
; nothing but the program's code runs.
!macro header {
        * = $1001
        !word .basic_end, 10
        !byte $9e
        !text "4109"
        !byte 0
.basic_end
        !word 0
        sei
        lda #$7f
        sta $912e
        sta $911e
}

; Screen and colour memory of the unexpanded machine.
SCREEN  = $1e00
COLOUR  = $9600
