{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Programmable HBLANK suite manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "build",
    "cases",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "word": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{4}$"
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "license",
        "source_revision"
      ],
      "properties": {
        "id": {
          "const": "org.198x.amiga.programmable-hblank"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "license": {
          "const": "CC0-1.0"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "version"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain",
        "case_file_sha256",
        "source_sha256"
      ],
      "properties": {
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "assembler",
            "linker",
            "python"
          ],
          "properties": {
            "target": {
              "const": "m68k-elf"
            },
            "assembler": {
              "$ref": "#/$defs/tool"
            },
            "linker": {
              "$ref": "#/$defs/tool"
            },
            "python": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "implementation",
                "version"
              ],
              "properties": {
                "implementation": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "case_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "symbols"
      ],
      "properties": {
        "word": {
          "$ref": "#/$defs/word"
        },
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "HIRES",
              "SHRES",
              "ECSENA",
              "EXTBLKEN",
              "PAL",
              "BLANKEN"
            ]
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agnus",
        "display_chip",
        "min_chip_ram_bytes",
        "regions"
      ],
      "properties": {
        "agnus": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "display_chip": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "min_chip_ram_bytes": {
          "type": "integer",
          "minimum": 262144
        },
        "regions": {
          "const": [
            "PAL"
          ]
        }
      }
    },
    "line_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_source",
        "register_minimum",
        "register_maximum",
        "register_modulus",
        "sample_beam_line",
        "horizontal_mapping",
        "guard_register",
        "guard_color_word"
      ],
      "properties": {
        "coordinate_source": {
          "const": "raw 11-bit HBSTRT/HBSTOP register words"
        },
        "register_minimum": {
          "const": 0
        },
        "register_maximum": {
          "const": 2047
        },
        "register_modulus": {
          "const": 2048
        },
        "sample_beam_line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 624
        },
        "horizontal_mapping": {
          "const": "producer-recorded"
        },
        "guard_register": {
          "const": "COLOR00"
        },
        "guard_color_word": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{3}$"
        }
      }
    },
    "programming_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "write_order",
        "steady_state"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "write_order": {
          "const": [
            "DMACON",
            "INTENA",
            "INTREQ",
            "BPLCON0 ECSENA access setup",
            "BPLCON3 palette-bank-zero setup",
            "COLOR00",
            "HBSTRT",
            "HBSTOP",
            "BEAMCON0",
            "BPLCON3",
            "BPLCON0"
          ]
        },
        "steady_state": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "settle_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_record_address",
        "ready_magic",
        "ready_magic_width_bytes",
        "case_number_address",
        "case_number_width_bytes",
        "schema_version_address",
        "schema_version_width_bytes",
        "field_counter_address",
        "field_counter_width_bytes",
        "byte_order",
        "ready_timeout_fields",
        "settle_fields",
        "capture_fields",
        "adjacent_field_stability_required"
      ],
      "properties": {
        "ready_record_address": {
          "const": "0x0002ff00"
        },
        "ready_magic": {
          "const": "HBLK"
        },
        "ready_magic_width_bytes": {
          "const": 4
        },
        "case_number_address": {
          "const": "0x0002ff04"
        },
        "case_number_width_bytes": {
          "const": 2
        },
        "schema_version_address": {
          "const": "0x0002ff06"
        },
        "schema_version_width_bytes": {
          "const": 2
        },
        "field_counter_address": {
          "const": "0x0002ff08"
        },
        "field_counter_width_bytes": {
          "const": 4
        },
        "byte_order": {
          "const": "big-endian"
        },
        "ready_timeout_fields": {
          "type": "integer",
          "minimum": 1
        },
        "settle_fields": {
          "type": "integer",
          "minimum": 1
        },
        "capture_fields": {
          "type": "integer",
          "minimum": 2
        },
        "adjacent_field_stability_required": {
          "const": true
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual",
        "serial"
      ],
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "color00",
            "description"
          ],
          "properties": {
            "method": {
              "const": "solid COLOR00"
            },
            "color00": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{3}$"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "serial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "encoding",
            "terminator",
            "value",
            "address",
            "maximum_bytes"
          ],
          "properties": {
            "encoding": {
              "const": "US-ASCII"
            },
            "terminator": {
              "const": "NUL"
            },
            "value": {
              "type": "string",
              "pattern": "^[ -~]+$"
            },
            "address": {
              "const": "0x0002ff20"
            },
            "maximum_bytes": {
              "const": 64
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "numeric_id",
        "question",
        "applicability",
        "registers",
        "resolution",
        "line_geometry",
        "programming_schedule",
        "settle_capture",
        "identity",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "numeric_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "question": {
          "type": "string",
          "pattern": "\\?$"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "registers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bplcon0",
            "bplcon3",
            "beamcon0",
            "hbstrt",
            "hbstop"
          ],
          "properties": {
            "bplcon0": {
              "$ref": "#/$defs/register"
            },
            "bplcon3": {
              "$ref": "#/$defs/register"
            },
            "beamcon0": {
              "$ref": "#/$defs/register"
            },
            "hbstrt": {
              "$ref": "#/$defs/register"
            },
            "hbstop": {
              "$ref": "#/$defs/register"
            }
          }
        },
        "resolution": {
          "enum": [
            "lores",
            "hires",
            "super-hires"
          ]
        },
        "line_geometry": {
          "$ref": "#/$defs/line_geometry"
        },
        "programming_schedule": {
          "$ref": "#/$defs/programming_schedule"
        },
        "settle_capture": {
          "$ref": "#/$defs/settle_capture"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "observations"
          ],
          "properties": {
            "status": {
              "const": "unresolved"
            },
            "observations": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "adf_file",
        "payload_file",
        "adf_bytes",
        "payload_bytes",
        "sha256",
        "load_address",
        "sectors",
        "bootblock_checksum"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "adf_file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.adf$"
        },
        "payload_file": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.bin$"
        },
        "adf_bytes": {
          "const": 901120
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adf",
            "payload"
          ],
          "properties": {
            "adf": {
              "$ref": "#/$defs/sha256"
            },
            "payload": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "load_address": {
          "const": 196608
        },
        "sectors": {
          "type": "integer",
          "minimum": 1
        },
        "bootblock_checksum": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{8}$"
        }
      }
    }
  }
}
